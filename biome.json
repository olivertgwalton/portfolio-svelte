{
	"$schema": "https://biomejs.dev/schemas/2.5.5/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": [
			"**",
			"!package-lock.json",
			"!pnpm-lock.yaml",
			"!yarn.lock",
			"!bun.lock",
			"!bun.lockb",
			"!static",
			"!drizzle",
			"!src/lib/wasm",
			"!rust-grid"
		]
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	},
	"html": {
		"experimentalFullSupportEnabled": true
	},
	"assist": {
		"enabled": false
	}
}
